$ LP03 public demonstration tire, Magic Formula 6.1.2.
$ Synthetic coefficients for example simulations, based on broad force and stiffness targets.
$ Peak pure-slip grip is tuned to approximately 70% of the LP03 reference tire at 800 N.

[MDI_HEADER]
FILE_TYPE = 'tir'
FILE_VERSION = 3
FILE_FORMAT = 'ASCII'

[UNITS]
